module

public import Freezing2.MainResults.Subcritical
public import Freezing2.Geometry.TreeMeasuredSpaces
public import Freezing2.Geometry.MeasuredGHMetric
public import Freezing2.Probability.PointMassLimit

/-!
# The subcritical main theorem in the GHP topology

The actual forward tree law is pushed to compact measured spaces modulo
whole-space measure-preserving isometry. Its GHP topology is generated by
the exact summed ambient-isometry infimum. Distance-tail convergence yields
weak convergence to the specified deterministic measured segment. Global
Polish-space properties are not premises of this argument.
-/

@[expose] public section

open Filter MeasureTheory
open scoped Topology

namespace Freezing2

/-- The actual scaled forward measured-tree law on GHP isometry classes. -/
noncomputable def forwardMeasuredTreeLaw (x : ℕ → ℕ → ℤ) (α : ℝ) (n : ℕ) :
    ProbabilityMeasure MeasuredGHSpace.{0} :=
  ProbabilityMeasure.map
    (⟨freezingTreeLaw x n, inferInstance⟩ : ProbabilityMeasure Freezing1.Forward.State)
    (fun s ↦ toMeasuredGHSpace (forwardMeasuredSpace (1 / (n : ℝ) ^ (1 - α)) s))

/-- **M02:** the actual forward uniformly measured trees, scaled by
`1/n^(1-α)`, converge in distribution for the exact GHP topology to the
source segment equipped with its profile image measure. -/
theorem subcritical_scaling_limit
    {x : ℕ → ℕ → ℤ} {α : ℝ} {f : ℝ → ℝ}
    (hx : ∀ n, 0 < n → IsSigned (x n) ∧ SurvivesThrough (x n) n)
    (hα0 : 0 < α) (hαhalf : α < 1 / 2)
    (hf : ∀ᵐ t ∂profileMeasure, 0 < f t)
    (hL1 : HasL1ReciprocalProfile x α (fun t ↦ 1 / f t))
    (h2 : HasLocalSquareMomentProfile x α (fun t ↦ 1 / f t)) :
    Tendsto (forwardMeasuredTreeLaw x α) atTop
      (𝓝 (⟨Measure.dirac (toMeasuredGHSpace
        (profileMeasuredSegment (fun t ↦ 1 / f t) hL1.1 (positiveProfile_reciprocal hf))),
        inferInstance⟩ : ProbabilityMeasure MeasuredGHSpace.{0})) := by
  apply tendsto_probabilityMap_const_of_tail
    (μ := fun n ↦ ⟨freezingTreeLaw x n, inferInstance⟩)
    (F := fun n s ↦ toMeasuredGHSpace
      (forwardMeasuredSpace (1 / (n : ℝ) ^ (1 - α)) s))
    (fun _ ↦ measurable_from_top)
  intro ε hε
  apply (subcritical_GHP_distance_limit_positive_horizons hx hα0 hαhalf hf hL1 h2 hε).congr'
  filter_upwards [eventually_gt_atTop 0] with n hn
  apply congrArg ENNReal.toReal
  apply measure_congr
  filter_upwards [freezingTreeLaw_valid x n] with s hs
  have hc : 0 < 1 / (n : ℝ) ^ (1 - α) :=
    one_div_pos.mpr (Real.rpow_pos_of_pos (by exact_mod_cast hn) _)
  rw [MeasuredGHSpace.dist_toMeasuredGHSpace,
    forwardMeasuredSpace_distance_profile _ hL1.1 (positiveProfile_reciprocal hf) hc hs.tree_connected]

end Freezing2

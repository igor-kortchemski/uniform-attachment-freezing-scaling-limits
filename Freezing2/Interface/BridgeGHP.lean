module

public import Freezing2.Interface.BridgeModel
public import Freezing2.MainResults.SubcriticalDistribution
public import Freezing2.Geometry.GHPUnderlyingProjection

/-!
# Bridge between the interface GHP topology and the library GHP space

An interface compact measured space has exactly the fields of a library one
(`toLib`, `ofLib`), and the interface GHP distance is literally the library
distance of the measured-isometry classes (`ghpDist_eq`). The interface GHP
topology, generated by the GHP balls, is therefore the topology induced by
the class map `ghpClass` into the library metric space `MeasuredGHSpace`
(`topology_eq`). Consequently every bounded continuous function factors
through `ghpClass`, and weak convergence of the library laws gives
convergence in distribution of the interface laws
(`convergesInDistribution_of_tendsto`). The class map has a measurable section
`ghpRep`, used to carry the limit law of the critical theorem. Finally, the
interface trees and segment represent the library ones.
-/

@[expose] public section

open MeasureTheory Filter Set Topology
open scoped ENNReal BoundedContinuousFunction

universe u

namespace FreezingStatements.Bridge

open Freezing2 (MeasuredGHSpace toMeasuredGHSpace)

/-! ## Spaces and classes -/

/-- The library space with the same fields. -/
def toLib (X : CompactMeasuredSpace.{u}) : Freezing2.CompactMeasuredSpace.{u} :=
  ⟨X.carrier, X.metric, X.nonempty, X.compact, X.measurable, X.borel, X.law⟩

/-- The interface space with the same fields. -/
def ofLib (X : Freezing2.CompactMeasuredSpace.{u}) : CompactMeasuredSpace.{u} :=
  ⟨X.carrier, X.metric, X.nonempty, X.compact, X.measurable, X.borel, X.law⟩

theorem toLib_ofLib (X : Freezing2.CompactMeasuredSpace.{u}) : toLib (ofLib X) = X := rfl

/-- The measured-isometry class of an interface space. -/
def ghpClass (X : CompactMeasuredSpace.{u}) : MeasuredGHSpace.{u} := toMeasuredGHSpace (toLib X)

/-- The interface GHP distance is the library GHP distance of the classes. -/
theorem ghpDist_eq (X Y : CompactMeasuredSpace.{u}) :
    X.ghpDist Y = dist (ghpClass X) (ghpClass Y) := rfl

theorem surjective_ghpClass : Function.Surjective ghpClass.{u} := by
  intro Z
  induction Z using Quotient.inductionOn with
  | _ Y => exact ⟨ofLib Y, rfl⟩

/-- Spaces with a measure-preserving isometry have the same class. -/
theorem ghpClass_eq_of_isometry (X : CompactMeasuredSpace.{u})
    (Y : Freezing2.CompactMeasuredSpace.{u}) (e : (toLib X) ≃ᵢ Y)
    (he : ((toLib X).law : Measure (toLib X)).map e = (Y.law : Measure Y)) :
    ghpClass X = toMeasuredGHSpace Y :=
  Quotient.sound ⟨e, he⟩

/-! ## The GHP topology -/

/-- The interface GHP topology is induced by the library GHP metric. -/
theorem topology_eq :
    instTopologicalSpaceCompactMeasuredSpace.{u} =
      TopologicalSpace.induced ghpClass inferInstance := by
  let pm : PseudoMetricSpace CompactMeasuredSpace.{u} :=
    PseudoMetricSpace.induced ghpClass inferInstance
  have hball (X : CompactMeasuredSpace.{u}) (r : ℝ) :
      {Y | X.ghpDist Y < r} = @Metric.ball _ pm X r := by
    ext Y
    change X.ghpDist Y < r ↔ dist (ghpClass Y) (ghpClass X) < r
    rw [ghpDist_eq, dist_comm]
  change TopologicalSpace.generateFrom _ = pm.toUniformSpace.toTopologicalSpace
  apply le_antisymm
  · rw [TopologicalSpace.le_def]
    intro U hU
    rw [@Metric.isOpen_iff _ pm] at hU
    refine isOpen_iff_forall_mem_open.mpr fun X hX ↦ ?_
    obtain ⟨ε, hε, hsub⟩ := hU X hX
    exact ⟨_, hsub, TopologicalSpace.isOpen_generateFrom_of_mem ⟨X, ε, (hball X ε).symm⟩,
      @Metric.mem_ball_self _ pm _ _ hε⟩
  · rw [TopologicalSpace.le_generateFrom_iff_subset_isOpen]
    rintro U ⟨X, r, rfl⟩
    rw [hball]
    exact @Metric.isOpen_ball _ pm X r

theorem isInducing_ghpClass : IsInducing ghpClass.{u} := ⟨topology_eq⟩

theorem continuous_ghpClass : Continuous ghpClass.{u} := isInducing_ghpClass.continuous

instance : BorelSpace CompactMeasuredSpace.{u} := ⟨rfl⟩

theorem measurable_ghpClass : Measurable ghpClass.{u} := continuous_ghpClass.measurable

/-- The interface Borel σ-algebra is the pullback of the library one. -/
theorem measurableSpace_eq_comap :
    instMeasurableSpaceCompactMeasuredSpace.{u} =
      MeasurableSpace.comap ghpClass Freezing2.MeasuredGHSpace.instMeasurableSpace := by
  change @borel CompactMeasuredSpace.{u} instTopologicalSpaceCompactMeasuredSpace = _
  rw [topology_eq, borel_comap]
  rfl

/-- A representative of each class. -/
noncomputable def ghpRep (Z : MeasuredGHSpace.{u}) : CompactMeasuredSpace.{u} := ofLib Z.out

theorem ghpClass_ghpRep (Z : MeasuredGHSpace.{u}) : ghpClass (ghpRep Z) = Z :=
  Quotient.out_eq Z

theorem ghpClass_comp_ghpRep : ghpClass.{u} ∘ ghpRep = id := funext ghpClass_ghpRep

theorem measurable_ghpRep : Measurable ghpRep.{u} := by
  rw [measurable_iff_comap_le, measurableSpace_eq_comap, MeasurableSpace.comap_comp,
    ghpClass_comp_ghpRep, MeasurableSpace.comap_id]

/-- Every bounded continuous function factors through the class map. -/
theorem exists_factor (F : CompactMeasuredSpace.{u} →ᵇ ℝ) :
    ∃ G : MeasuredGHSpace.{u} →ᵇ ℝ, ∀ X, G (ghpClass X) = F X := by
  let q₀ : C(CompactMeasuredSpace.{u}, MeasuredGHSpace.{u}) := ⟨ghpClass, continuous_ghpClass⟩
  have hq : IsQuotientMap q₀ :=
    isInducing_ghpClass.isQuotientMap_of_surjective surjective_ghpClass
  let F₀ : C(CompactMeasuredSpace.{u}, ℝ) := ⟨F, F.continuous⟩
  have hfac : Function.FactorsThrough F₀ q₀ := by
    intro a b hab
    change ghpClass a = ghpClass b at hab
    have hab' : Inseparable a b :=
      isInducing_ghpClass.inseparable_iff.mp (hab ▸ Inseparable.refl _)
    exact (hab'.map F.continuous).eq
  let G₀ : C(MeasuredGHSpace.{u}, ℝ) := hq.lift F₀ hfac
  have hG₀ (X : CompactMeasuredSpace.{u}) : G₀ (ghpClass X) = F X :=
    DFunLike.congr_fun (hq.lift_comp F₀ hfac) X
  obtain ⟨C, hC⟩ := F.bounded
  refine ⟨BoundedContinuousFunction.mkOfBound G₀ C fun z w ↦ ?_, hG₀⟩
  obtain ⟨a, rfl⟩ := surjective_ghpClass z
  obtain ⟨b, rfl⟩ := surjective_ghpClass w
  simpa only [hG₀] using hC a b

theorem integral_eq_integral_map (F : CompactMeasuredSpace.{u} →ᵇ ℝ)
    (G : MeasuredGHSpace.{u} →ᵇ ℝ) (hG : ∀ X, G (ghpClass X) = F X)
    (μ : Measure CompactMeasuredSpace.{u}) :
    ∫ X, F X ∂μ = ∫ Z, G Z ∂(μ.map ghpClass) := by
  rw [integral_map measurable_ghpClass.aemeasurable G.continuous.aestronglyMeasurable]
  simp only [hG]

/-- Weak convergence of the library laws gives convergence in distribution of
interface laws with these images. -/
theorem convergesInDistribution_of_tendsto {μ : ℕ → Measure CompactMeasuredSpace.{u}}
    {ν : Measure CompactMeasuredSpace.{u}} {P : ℕ → ProbabilityMeasure MeasuredGHSpace.{u}}
    {Q : ProbabilityMeasure MeasuredGHSpace.{u}}
    (hP : ∀ᶠ n in atTop, (μ n).map ghpClass = P n) (hQ : ν.map ghpClass = Q)
    (h : Tendsto P atTop (𝓝 Q)) : ConvergesInDistribution μ ν := by
  intro F
  obtain ⟨G, hG⟩ := exists_factor F
  rw [ProbabilityMeasure.tendsto_iff_forall_integral_tendsto] at h
  rw [integral_eq_integral_map F G hG ν, hQ]
  refine (h G).congr' ?_
  filter_upwards [hP] with n hn
  rw [integral_eq_integral_map F G hG (μ n), hn]

/-- A property holding for every representative of almost every class holds
almost surely for the law of the chosen representatives. -/
theorem ae_map_ghpRep {Q : Measure MeasuredGHSpace.{u}} {P : CompactMeasuredSpace.{u} → Prop}
    (h : ∀ᵐ Z ∂Q, ∀ X, ghpClass X = Z → P X) : ∀ᵐ X ∂(Q.map ghpRep), P X := by
  rw [ae_iff] at h ⊢
  obtain ⟨M, hNM, hM, hQM⟩ := exists_measurable_superset_of_null h
  apply measure_mono_null (t := ghpClass ⁻¹' M)
  · intro X hX
    exact hNM fun hall ↦ hX (hall X rfl)
  · rw [Measure.map_apply measurable_ghpRep (measurable_ghpClass hM), ← preimage_comp,
      ghpClass_comp_ghpRep, preimage_id]
    exact hQM

/-! ## The trees and the segment -/

/-- Uniform measures on a finite type agree for any two σ-algebras with
measurable singletons. -/
theorem map_uniformOn_univ {V : Type*} [Fintype V] [Nonempty V] (m₁ m₂ : MeasurableSpace V)
    (h₁ : @MeasurableSingletonClass V m₁) (h₂ : @MeasurableSingletonClass V m₂) :
    @Measure.map V V m₁ m₂ id (@ProbabilityTheory.uniformOn V m₁ univ) =
      @Measure.uniformOfFinset V m₂ Finset.univ := by
  classical
  apply @Measure.ext_of_singleton V m₂ (Finite.to_countable)
  intro a
  rw [@Measure.map_apply V V m₁ m₂ _ _ (@measurable_of_countable V V m₁ m₂ _ h₁ id)
      _ (@measurableSet_singleton V m₂ h₂ a), preimage_id,
    @ProbabilityTheory.uniformOn_univ V m₁, @Measure.count_singleton V m₁ h₁,
    @Measure.uniformOfFinset_apply_singleton_of_mem V m₂ h₂ _ _ (Finset.mem_univ a),
    Finset.card_univ, one_div]

/-- The interface scaled tree represents the library scaled tree. -/
theorem ghpClass_treeSpace (c : ℝ) (s : Freezing1.Forward.State) :
    ghpClass (treeSpace c (forget s)) =
      toMeasuredGHSpace (Freezing2.forwardMeasuredSpace c s) := by
  unfold treeSpace Freezing2.forwardMeasuredSpace
  by_cases h : s.tree.Connected ∧ 0 < c
  · rw [dite_eq_left (show (forget s).tree.Connected ∧ 0 < c from h), dite_eq_left h]
    refine ghpClass_eq_of_isometry _ _ ⟨Equiv.refl _, fun _ _ ↦ rfl⟩ ?_
    have : Nonempty {v // v ∈ s.vertices} := h.1.nonempty
    refine map_uniformOn_univ (V := {v // v ∈ s.vertices}) _ _ ?_
      (inferInstance : @MeasurableSingletonClass {v // v ∈ s.vertices} Subtype.instMeasurableSpace)
    let := scaledGraphMetric s.tree h.1 c h.2
    let : MeasurableSpace {v // v ∈ s.vertices} := borel _
    have : BorelSpace {v // v ∈ s.vertices} := ⟨rfl⟩
    exact (inferInstance : MeasurableSingletonClass {v // v ∈ s.vertices})
  · rw [dite_eq_right (show ¬((forget s).tree.Connected ∧ 0 < c) from h), dite_eq_right h]
    rfl

/-- The interface scaled tree laws have the library tree laws as images. -/
theorem map_scaledTreeLaw (x : ℕ → ℕ → ℤ) (α : ℝ) (n : ℕ) :
    (scaledTreeLaw (x n) n (1 / (n : ℝ) ^ (1 - α))).map ghpClass =
      (Freezing2.forwardMeasuredTreeLaw x α n : Measure MeasuredGHSpace.{0}) := by
  rw [scaledTreeLaw, treeLaw_eq_map_freezingTreeLaw,
    Measure.map_map measurable_from_top measurable_forget,
    Measure.map_map measurable_ghpClass measurable_from_top]
  change _ = (Freezing2.freezingTreeLaw x n).map _
  congr 1
  funext s
  exact ghpClass_treeSpace _ s

/-- The interface segment represents the library segment. -/
theorem ghpClass_measuredSegment {f : ℝ → ℝ} (hf : ∀ᵐ t ∂profileMeasure, 0 < f t)
    (hL1 : Integrable (fun t ↦ 1 / f t) profileMeasure) :
    ghpClass (measuredSegment (branchLength f 1) (branchLength f)) =
      toMeasuredGHSpace (Freezing2.profileMeasuredSegment (fun t ↦ 1 / f t) hL1
        (Freezing2.positiveProfile_reciprocal hf)) := by
  set g : ℝ → ℝ := fun t ↦ 1 / f t with hg
  have hpos := Freezing2.positiveProfile_reciprocal hf
  have hL : branchLength f 1 = Freezing2.profilePrimitive g 1 :=
    branchLength_eq_profilePrimitive f ⟨zero_le_one, le_rfl⟩
  have himage := Freezing2.profilePrimitive_image_unitInterval hL1 hpos
  have hmem (t : ℝ) (ht : t ∈ Icc (0 : ℝ) 1) :
      Freezing2.profilePrimitive g t ∈ Icc 0 (branchLength f 1) := by
    rw [hL, ← himage]
    exact mem_image_of_mem _ ht
  have h0 : 0 ≤ branchLength f 1 :=
    (hmem 0 ⟨le_rfl, zero_le_one⟩).1.trans (hmem 0 ⟨le_rfl, zero_le_one⟩).2
  unfold measuredSegment
  rw [dite_eq_left h0]
  let e : (Icc (0 : ℝ) (branchLength f 1)) ≃ᵢ Freezing2.ProfileSegment g :=
    { toEquiv := Equiv.subtypeEquivRight fun y ↦ by rw [hL]
      isometry_toFun := Isometry.of_dist_eq fun _ _ ↦ rfl }
  refine ghpClass_eq_of_isometry _ _ e ?_
  let ψ : unitInterval → Icc (0 : ℝ) (branchLength f 1) :=
    fun t ↦ projIcc 0 (branchLength f 1) h0 (branchLength f t)
  have hψ : ψ = fun t : unitInterval ↦
      projIcc 0 (branchLength f 1) h0 (Freezing2.profilePrimitive g t) := by
    funext t
    simp only [ψ, branchLength_eq_profilePrimitive f t.2, g]
  have hψc : Continuous ψ := by
    rw [hψ]
    exact continuous_projIcc.comp
      ((Freezing2.continuous_profilePrimitive hL1).comp continuous_subtype_val)
  have hcomp : (Subtype.val ∘ e ∘ ψ) = Freezing2.profilePrimitive g ∘ Subtype.val := by
    funext t
    rw [hψ]
    exact congrArg Subtype.val (projIcc_of_mem h0 (hmem t t.2))
  change Measure.map e (Measure.map ψ (volume : Measure unitInterval)) =
    Measure.map (Freezing2.profileSegmentMap g hL1 hpos) profileMeasure
  have hemb : MeasurableEmbedding (Subtype.val : Freezing2.ProfileSegment g → ℝ) :=
    MeasurableEmbedding.subtype_coe measurableSet_Icc
  rw [← hemb.comap_map (Measure.map (Freezing2.profileSegmentMap g hL1 hpos) profileMeasure),
    ← hemb.comap_map (Measure.map e (Measure.map ψ volume))]
  congr 1
  rw [Measure.map_map measurable_subtype_coe
      (Freezing2.continuous_profileSegmentMap hL1 hpos).measurable,
    Measure.map_map measurable_subtype_coe e.continuous.measurable,
    Measure.map_map (measurable_subtype_coe.comp e.continuous.measurable) hψc.measurable]
  change Measure.map (Subtype.val ∘ e ∘ ψ) volume = _
  rw [hcomp, ← Measure.map_map (Freezing2.continuous_profilePrimitive hL1).measurable
      measurable_subtype_coe, unitInterval.measurePreserving_coe.map_eq]
  apply Measure.map_congr
  filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
  exact (Freezing2.profileSegmentMap_coe hL1 hpos ht).symm

end FreezingStatements.Bridge
